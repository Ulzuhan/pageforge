# Copy for local runs. Every variable exists twice: PAGEFORGE_* and INKBAR_*.
# Without the OIDC block or a 32-byte session secret, sign-in is off and the
# server says so in its log; the landing page still works.
PAGEFORGE_OIDC_ISSUER=https://id.example.com/realms/example
# Where the SERVER reaches the provider (internal network); defaults to the issuer's origin.
PAGEFORGE_OIDC_INTERNAL_BASE=
PAGEFORGE_OIDC_CLIENT_ID=
PAGEFORGE_OIDC_CLIENT_SECRET=
PAGEFORGE_OIDC_REDIRECT_URI=https://page.example.com/auth/callback
# The group the access token (or UserInfo) must carry. Empty: the provider alone decides.
PAGEFORGE_OIDC_REQUIRED_GROUP=pageforge
PAGEFORGE_OIDC_TIMEOUT_MS=10000
# At least 32 bytes: openssl rand -base64 48
PAGEFORGE_SESSION_SECRET=
PAGEFORGE_SESSION_TTL_HOURS=2
# Link to the account app; without it there is no Account button.
PAGEFORGE_ACCOUNT_URL=
# Only for local http runs: cookies without Secure and without the __Host- prefix.
PAGEFORGE_INSECURE_COOKIES=
HOSTNAME=127.0.0.1
PORT=3468
